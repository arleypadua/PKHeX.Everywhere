{
  "name": "@pkhex-everywhere/engine",
  "version": "0.0.0",
  "description": "PKHeX in the browser: load, read and edit Pokémon save files.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arleypadua/PKHeX.Everywhere.git",
    "directory": "src/PKHeX.Everywhere.Engine.Sdk/packages/engine"
  },
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "source": "./src/vite.ts",
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    }
  },
  "files": [
    "dist",
    "_framework"
  ],
  "scripts": {
    "build": "node scripts/publish-framework.mjs && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "crypto-js": "^4.2.0"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^24.19.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
