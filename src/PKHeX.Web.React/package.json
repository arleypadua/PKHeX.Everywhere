    "@pkhex-everywhere/react": "file:../PKHeX.Everywhere.Engine.Sdk/packages/react",
    "@sentry/browser": "^11.2.0",
    "antd": "^6.6.5",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.23",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@pkhex-everywhere/plugin-sdk": "file:../PKHeX.Everywhere.Engine.Sdk/packages/plugin-sdk",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
