@page "/events"
@using PKHeX.Web.Components.Events

<Flex Direction="FlexDirection.Vertical" Style="width: 100%; gap: 20px;">
    <PageHeader BackIcon="true" Style="max-width: 100%">
        <TitleTemplate>Events</TitleTemplate>
    </PageHeader>

    <Alert
        Type="@AlertType.Warning"
        Message="Changing event flags can break story progression. Keep a backup of your save."
        ShowIcon="true"/>

    @if (GameEvents is null)
    {
        <Empty Description="@("This save has no event labels to edit.")"/>
    }
    else
    {
        <Tabs Class="tab-scrollable" Animated>
            @if (GameEvents.Gen3 is not null)
            {
                <TabPane Tab="Tickets and islands" Key="gen3">
                    <Gen3EventsTab Gen3="GameEvents.Gen3"/>
                </TabPane>
            }
            <TabPane Tab="Flags" Key="flags">
                <EventFlagsTab Events="GameEvents"/>
            </TabPane>
            @if (!GameEvents.Work.IsEmpty)
            {
                <TabPane Tab="Work" Key="work">
                    <EventWorkTab Events="GameEvents"/>
                </TabPane>
            }
        </Tabs>
    }
</Flex>

@code {
    [Inject] public required GameService GameService { get; set; }

    PKHeX.Facade.Events.GameEvents? GameEvents => GameService.Game?.Events;
}
