@page "/plugins"
@using PKHeX.Web.Services.Plugins
@implements IDisposable
@inject INotificationService Notification

<Flex Direction="FlexDirection.Vertical" Style="width: 100%; gap: 20px;">
    <PageHeader BackIcon="true" Style="max-width: 100%">
        <TitleTemplate>Manage Plug-Ins</TitleTemplate>
    </PageHeader>

    @if (InstalledPlugIns.Any())
    {
        <Title Level="2">Installed</Title>
        <Table
            TItem="InstalledRow"
            DataSource="@InstalledPlugIns"
            @bind-PageIndex="_installedPlugInsPageIndex"
            @bind-PageSize="_installedPlugInsPageSize"
            Size="TableSize.Small"
            Responsive
            EnableVirtualization>
            <PropertyColumn Title="Name" Property="@(c => c.Name)" Sortable Filterable>
                @if (context.PlugIn is not null)
                {
                    <a href="@($"/plugins/{context.Id}")">@context.Name</a>
                }
                else
                {
                    @context.Name
                }
            </PropertyColumn>
            <PropertyColumn Title="Version" Property="@(c => c.Version)" Sortable Filterable>
                @if (context.PlugIn is null)
                {
                    <Tooltip Title="@("This plug-in doesn't work with this version of the app. Uninstall it and install it again.")">
                        <Tag Color="@TagColor.Warning">Needs reinstall</Tag>
                    </Tooltip>
                }
                else
                {
                    @context.Version
                }
            </PropertyColumn>
            <ActionColumn Title="Actions">
                <Space Size=@("middle")>
                    <SpaceItem>
                        <Button
                            OnClick="() => HandleUninstallClick(context.Id)"
                            Type="@ButtonType.Link"
                            Danger>
                            Uninstall
                        </Button>
                    </SpaceItem>

                    @if (context.PlugIn is { HasNewerVersion: true } plugIn)
                    {
                        <SpaceItem>
                            <Button
                                OnClick="() => HandleUpdateClick(plugIn)"
                                Type="@ButtonType.Link">
                                Update
                            </Button>
                        </SpaceItem>   
                    }
                </Space>
            </ActionColumn>
        </Table>
    }

    @if (_availablePlugIns.Any())
    {
        <Title Level="2">Discover</Title>
        <Table
            TItem="PlugInAndSource"
            DataSource="@_availablePlugIns"
            @bind-PageIndex="_availablePlugInsPageIndex"
            @bind-PageSize="_availablePlugInsPageSize"
            Size="TableSize.Small"
            Responsive
            EnableVirtualization>
            <PropertyColumn Title="Name" Property="@(c => c.PlugIn.Id)" Sortable Filterable>
                <LabelOrLink
                    Label="@context.PlugIn.Name"
                    Href="@context.PlugIn.ProjectUrl"/>
            </PropertyColumn>
            <PropertyColumn Title="Description" Property="@(c => c.PlugIn.Description)"/>
            <PropertyColumn Title="Version" Property="@(c => c.PlugIn.NewestCompatibleVersion!.Version)" Sortable Filterable/>
            <PropertyColumn Title="Source" Property="@(c => c.Source.Name)" Sortable Filterable/>
            <ActionColumn Title="Actions">
                <Space Size=@("middle")>
                    <SpaceItem>
                        <Button
                            Type="@ButtonType.Link"
                            OnClick="() => HandleInstallClick(context.Source, context.PlugIn)">
                            Install
                        </Button>
                    </SpaceItem>
                </Space>
            </ActionColumn>
        </Table>
    }

</Flex>

@code {
    [Inject] public required PlugInRegistry Registry { get; set; }
    [Inject] public required PlugInService PlugInService { get; set; }
    [Inject] public required PlugInSourceService PlugInSourceService { get; set; }

    private List<PlugInAndSource> _availablePlugIns = [];

    private List<InstalledRow> InstalledPlugIns =>
    [
        .. Registry.GetAllPlugins().Select(p => new InstalledRow
        {
            Id = p.Id, Name = p.Manifest.PlugInName, Version = p.Version.ToString(), PlugIn = p
        }),
        .. Registry.NeedsReinstall.Select(p => new InstalledRow { Id = p.Id, Name = p.Id, Version = string.Empty }),
    ];

    private int _availablePlugInsPageIndex = 1;
    private int _availablePlugInsPageSize = 20;

    private int _installedPlugInsPageIndex = 1;
    private int _installedPlugInsPageSize = 20;

    private async Task HandleUninstallClick(string plugInId)
    {
        await PlugInService.Uninstall(plugInId);
        await RefreshAvailablePlugIns();
    }

    private async Task HandleInstallClick(PlugInSource source, PlugInSource.PlugIn plugin)
    {
        await PlugInService.InstallFrom(source.SourceUrl, source.GetLatestDownloadUrl(plugin));
        
        _ = Notification.Open(new NotificationConfig
        {
            Message = "Plug-in updated with success",
            NotificationType = NotificationType.Success
        });
        
        await RefreshAvailablePlugIns();
    }
    
    private async Task HandleUpdateClick(InstalledPlugIn plugIn)
    {
        try
        {
            await PlugInService.Update(plugIn);
        }
        catch (HttpRequestException)
        {
            _ = Notification.Open(new()
            {
                Message = "Couldn't reach the plug-in source",
                Description = "Try again later.",
                NotificationType = NotificationType.Error,
            });
            return;
        }

        await RefreshAvailablePlugIns();
    }

    protected override Task OnInitializedAsync()
    {
        Registry.OnPlugInChanged += HandlePlugInChanged;
        return RefreshAvailablePlugIns();
    }

    private void HandlePlugInChanged(string plugInId, PlugInRegistry.ChangeType type) => InvokeAsync(async () =>
    {
        await RefreshAvailablePlugIns();
        StateHasChanged();
    });

    public void Dispose() => Registry.OnPlugInChanged -= HandlePlugInChanged;

    private async Task RefreshAvailablePlugIns()
    {
        _availablePlugIns = (await PlugInSourceService.GetPlugInSources())
            .SelectMany(
                p => p.PlugIns,
                (source, plugin) => new PlugInAndSource { Source = source, PlugIn = plugin })
            .Where(p => !Registry.IsRegistered(p.PlugIn.Id) && p.PlugIn.NewestCompatibleVersion is not null)
            .ToList();
    }

    class PlugInAndSource
    {
        public required PlugInSource Source { get; set; }
        public required PlugInSource.PlugIn PlugIn { get; set; }
    }

    class InstalledRow
    {
        public required string Id { get; init; }
        public required string Name { get; init; }
        public required string Version { get; init; }
        public InstalledPlugIn? PlugIn { get; init; }
    }

}