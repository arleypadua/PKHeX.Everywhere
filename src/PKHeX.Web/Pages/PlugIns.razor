@page "/plugins"
@using PKHeX.Everywhere.Engine
@using PKHeX.Web.Services.Plugins
@implements IDisposable
@inject INotificationService Notification
@inject Session Session
@inject PlugInStore PlugInStore
@inject NavigationManager Navigation

<Flex Direction="FlexDirection.Vertical" Style="width: 100%; gap: 20px;">
    <PageHeader BackIcon="true" Style="max-width: 100%">
        <TitleTemplate>Manage Plug-Ins</TitleTemplate>
    </PageHeader>

    @if (InstalledPlugIns.Any())
    {
        <Title Level="2">Installed</Title>
        <Table
            TItem="InstalledPlugIn"
            DataSource="@InstalledPlugIns"
            @bind-PageIndex="_installedPlugInsPageIndex"
            @bind-PageSize="_installedPlugInsPageSize"
            Size="TableSize.Small"
            Responsive
            EnableVirtualization>
            <PropertyColumn Title="Name" Property="@(c => c.Name)" Sortable Filterable>
                @if (!context.NeedsReinstall)
                {
                    <a href="@($"/plugins/{context.Id}")">@context.Name</a>
                }
                else
                {
                    @context.Name
                }
            </PropertyColumn>
            <PropertyColumn Title="Version" Property="@(c => c.Version)" Sortable Filterable>
                @if (context.NeedsReinstall)
                {
                    <Tooltip Title="@("This plug-in doesn't work with this version of the app. Uninstall it and install it again.")">
                        <Tag Color="@TagColor.Warning">Needs reinstall</Tag>
                    </Tooltip>
                }
                else
                {
                    @context.Version
                }
            </PropertyColumn>
            <ActionColumn Title="Actions">
                <Space Size=@("middle")>
                    <SpaceItem>
                        <Button
                            OnClick="() => HandleUninstallClick(context.Id)"
                            Type="@ButtonType.Link"
                            Danger>
                            Uninstall
                        </Button>
                    </SpaceItem>

                    @if (context.HasNewerVersion)
                    {
                        <SpaceItem>
                            <Button
                                OnClick="() => HandleUpdateClick(context.Id)"
                                Type="@ButtonType.Link">
                                Update
                            </Button>
                        </SpaceItem>   
                    }
                </Space>
            </ActionColumn>
        </Table>
    }

    @if (_availablePlugIns.Any())
    {
        <Title Level="2">Discover</Title>
        <Table
            TItem="AvailablePlugIn"
            DataSource="@_availablePlugIns"
            @bind-PageIndex="_availablePlugInsPageIndex"
            @bind-PageSize="_availablePlugInsPageSize"
            Size="TableSize.Small"
            Responsive
            EnableVirtualization>
            <PropertyColumn Title="Name" Property="@(c => c.Id)" Sortable Filterable>
                <LabelOrLink
                    Label="@context.Name"
                    Href="@context.ProjectUrl"/>
            </PropertyColumn>
            <PropertyColumn Title="Description" Property="@(c => c.Description)"/>
            <PropertyColumn Title="Version" Property="@(c => c.Version)" Sortable Filterable/>
            <PropertyColumn Title="Source" Property="@(c => c.SourceName)" Sortable Filterable/>
            <ActionColumn Title="Actions">
                <Space Size=@("middle")>
                    <SpaceItem>
                        <Button
                            Type="@ButtonType.Link"
                            OnClick="() => HandleInstallClick(context)">
                            Install
                        </Button>
                    </SpaceItem>
                </Space>
            </ActionColumn>
        </Table>
    }

</Flex>

@code {
    private List<AvailablePlugIn> _availablePlugIns = [];
    private List<InstalledPlugIn> InstalledPlugIns { get; set; } = [];

    private int _availablePlugInsPageIndex = 1;
    private int _availablePlugInsPageSize = 20;

    private int _installedPlugInsPageIndex = 1;
    private int _installedPlugInsPageSize = 20;

    private async Task HandleUninstallClick(string plugInId)
    {
        await PlugInStore.Uninstall(plugInId);
    }

    private async Task HandleInstallClick(AvailablePlugIn plugIn)
    {
        if (!await TryReachingTheSource(() => PlugInStore.Install(plugIn.SourceUrl, plugIn.Id))) return;

        _ = Notification.Open(new NotificationConfig
        {
            Message = "Plug-in installed with success",
            NotificationType = NotificationType.Success
        });
        Navigation.NavigateToPlugIn(plugIn.Id);
    }

    private Task HandleUpdateClick(string plugInId) => TryReachingTheSource(() => PlugInStore.Update(plugInId));

    private async Task<bool> TryReachingTheSource(Func<Task> call)
    {
        try
        {
            await call();
            return true;
        }
        catch (JSException)
        {
            _ = Notification.Open(new()
            {
                Message = "Couldn't reach the plug-in source",
                Description = "Try again later.",
                NotificationType = NotificationType.Error,
            });
            return false;
        }
    }

    protected override Task OnInitializedAsync()
    {
        Session.Changed += HandleSessionChanged;
        return Refresh();
    }

    private void HandleSessionChanged(string[] topics)
    {
        if (topics.Any(t => t is Topics.All or Topics.PlugIns)) InvokeAsync(async () =>
        {
            await Refresh();
            StateHasChanged();
        });
    }

    public void Dispose() => Session.Changed -= HandleSessionChanged;

    private async Task Refresh()
    {
        InstalledPlugIns = PlugInHandlers.Installed(Session).ToList();
        _availablePlugIns = (await PlugInStore.Available()).ToList();
    }
}
