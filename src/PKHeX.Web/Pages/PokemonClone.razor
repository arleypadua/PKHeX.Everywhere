@page "/pokemon/{PartyOrBox}/{UniqueIdString}/clone"

<PageTitle>Clone Pokemon</PageTitle>

<ReactPage Name="pokemon-clone" Props="@(new() { ["source"] = PartyOrBox, ["id"] = UniqueIdString })" />

@code {
    [Parameter] public required string PartyOrBox { get; set; }
    [Parameter] public required string UniqueIdString { get; set; }
}
