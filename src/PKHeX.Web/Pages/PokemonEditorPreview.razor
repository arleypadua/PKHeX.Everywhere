@page "/pokemon-next/{PartyOrBox}/{UniqueIdString}"

<PageTitle>Pokemon (preview)</PageTitle>

<ReactPage Name="pokemon-editor" Props="@(new() { ["source"] = PartyOrBox, ["id"] = UniqueIdString })" />

@code {
    [Parameter] public required string PartyOrBox { get; set; }
    [Parameter] public required string UniqueIdString { get; set; }
}
