@page "/pokemon/search-encounter"
@inject GameService GameService
@inject NavigationManager Navigation

<PageTitle>Encounters</PageTitle>

@if (GameService.IsLoaded)
{
    <ReactPage Name="encounters" Props="@(new() { ["version"] = Version, ["species"] = Species })" />
}

@code {
    [SupplyParameterFromQuery(Name = "version")]
    public int? Version { get; set; }

    [SupplyParameterFromQuery(Name = "species")]
    public int? Species { get; set; }

    protected override void OnInitialized()
    {
        if (!GameService.IsLoaded) Navigation.NavigateTo("/load", replace: true);
    }
}
