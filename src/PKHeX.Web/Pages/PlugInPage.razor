@page "/plugins/{Id}/{Path}"
@page "/plugins/{Id}/{Path}/standard"
@using PKHeX.Everywhere.Engine.PlugIns
@using PKHeX.Everywhere.PlugIns
@implements IDisposable
@inject PlugInHost Host
@inject NavigationManager Navigation
@inject PKHeX.Everywhere.Engine.Session Session

@if (_declared is not null)
{
    <ReactPage @key="_declared" Name="plugin-page" Props="@(new() { ["plugInId"] = Id, ["path"] = Path })" RequiresSave="false" />
}

@code {
    [Parameter] public required string Id { get; set; }
    [Parameter] public required string Path { get; set; }

    private DeclaredPage? _declared;

    protected override void OnInitialized() => Session.Changed += HandleSessionChanged;

    // Stored plug-ins register after the first render, so a page opened directly finds its plug-in late.
    private void HandleSessionChanged(string[] topics)
    {
        if (_declared is null && topics.Contains(PKHeX.Everywhere.Engine.Topics.PlugIns)) InvokeAsync(() =>
        {
            OnParametersSet();
            StateHasChanged();
        });
    }

    public void Dispose() => Session.Changed -= HandleSessionChanged;

    protected override void OnParametersSet()
    {
        _declared = Host.Pages().FirstOrDefault(p => p.PlugInId == Id && p.Path == Path);
        if (_declared is { Layout: not PageLayout.Standard })
        {
            Navigation.NavigateToPlugInPage(Id, Path, _declared.Layout.ToString(), replace: true);
            _declared = null;
        }
    }
}
