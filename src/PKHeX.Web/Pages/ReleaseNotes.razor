@page "/release-notes"
@inject NewsService NewsService

<PageTitle>Release Notes</PageTitle>

<ReactPage Name="release-notes" RequiresSave="false" Props="@(new() { ["entries"] = NewsService.AllNews, ["since"] = Since })" />

@code {
    [SupplyParameterFromQuery(Name = "since")]
    public string? Since { get; set; }
}
