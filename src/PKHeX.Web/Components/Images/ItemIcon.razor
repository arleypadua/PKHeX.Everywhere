@using System.Text.RegularExpressions
@using PKHeX.Facade.Repositories

@if (Item.Id != ItemDefinition.None && !string.IsNullOrEmpty(Item.Name))
{
    <Image Src="@ContentUrl()" Style="width: 30px" Preview="false"></Image>
}

@code {
    [Parameter] public required ItemDefinition Item { get; set; }

    private string ContentUrl() => $"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/{ItemName}.png";

    // PokeAPI only has per-type TM sprites and no TR sprites; the TM's move type isn't known here
    private string ItemName => Regex.IsMatch(Item.Name, @"^T[MR]\d+$")
        ? "tm-normal"
        : string.Join('-', Item.Name.ToLower().Replace("é", "e").Split(' '));
}
