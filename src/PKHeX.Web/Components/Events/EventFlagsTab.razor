@using PKHeX.Facade.Events

<Flex Direction="FlexDirection.Vertical" Style="width: 100%; gap: 16px;">
    <EventFilterBar
        @bind-Search="_search"
        @bind-Category="_category"
        Categories="@Events.Flags.Select(f => f.Category).Distinct()"/>

    <Table
        TItem="EventFlagEntry"
        DataSource="@Filtered"
        Size="TableSize.Small"
        @bind-PageSize="_pageSize"
        Responsive>
        <PropertyColumn Title="Set" Property="f => f.Value" Width="60">
            <Checkbox Checked="@context.Value" CheckedChanged="v => context.Value = v"/>
        </PropertyColumn>
        <PropertyColumn Title="#" Property="f => f.Index" Width="80"/>
        <PropertyColumn Title="Name" Property="f => f.Name"/>
        <PropertyColumn Title="Category" Property="f => f.Category">
            @EventFilterBar.Humanize(context.Category)
        </PropertyColumn>
    </Table>

    <Card Size="CardSize.Small" Title="Edit by index">
        <Space Align="SpaceAlign.Center">
            <SpaceItem>
                <AntDesign.InputNumber
                    TValue="int"
                    @bind-Value="_index"
                    Min="0"
                    Max="@(Events.FlagCount - 1)"/>
            </SpaceItem>
            <SpaceItem>
                <Checkbox
                    Checked="@Events.GetFlag(_index)"
                    CheckedChanged="v => Events.SetFlag(_index, v)">
                    Set
                </Checkbox>
            </SpaceItem>
        </Space>
    </Card>
</Flex>

@code {
    [Parameter] public required GameEvents Events { get; set; }

    string? _search;
    string? _category;
    int _pageSize = 20;
    int _index;

    IEnumerable<EventFlagEntry> Filtered => Events.Flags
        .Where(f => EventFilterBar.Matches(f.Name, f.Category, _search, _category));
}
