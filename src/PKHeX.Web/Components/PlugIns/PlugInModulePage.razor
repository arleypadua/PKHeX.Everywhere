@using PKHeX.Everywhere.Engine.PlugIns
@using PKHeX.Everywhere.PlugIns
@implements IAsyncDisposable
@inject IJSRuntime Js
@inject PlugInHost Host
@inject GameService GameService
@inject AntdThemeService ThemeService
@inject NavigationManager Navigation

@if (Page.Layout == PageLayout.Standard)
{
    <Flex Direction="FlexDirection.Vertical" Style="width: 100%; gap: 20px;">
        <PageHeader BackIcon="true" Style="max-width: 100%">
            <TitleTemplate>@(Page.Title ?? Page.Path)</TitleTemplate>
        </PageHeader>

        <div @ref="_element" style="width: 100%"></div>
    </Flex>
}
else
{
    <div @ref="_element" style="width: 100%; height: 100%"></div>
}

@code {
    [Parameter, EditorRequired] public required DeclaredPage Page { get; set; }

    private readonly string _id = Guid.NewGuid().ToString("N");
    private ElementReference _element;
    private IJSObjectReference? _module;
    private DotNetObjectReference<PlugInModulePage>? _self;
    private bool _disposed;

    protected override void OnInitialized() => AntdThemeService.ThemeChanged += HandleThemeChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var source = Host.PageModule(Page.PlugInId, Page.Path);
        _module = await Js.InvokeAsync<IJSObjectReference>("import", "./Components/PlugIns/PlugInModulePage.razor.js");
        if (_disposed) return;
        _self = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("mount", _id, _element, source, Page.PlugInId, ThemeName(ThemeService.Theme), _self);
    }

    [JSInvokable]
    public SaveFile? GetSave() => GameService.Game is { } game
        ? new SaveFile(game.ToByteArray(), GameService.FileName ?? string.Empty, game.GameVersionApproximation.Version.ToString())
        : null;

    [JSInvokable]
    public object? GetSetting(string key) => Host.Find(Page.PlugInId)?.Settings.GetOrDefault(key) switch
    {
        Settings.SettingValue.FileValue file => file.Value,
        Settings.SettingValue.StringValue text => text.Value,
        Settings.SettingValue.BooleanValue boolean => boolean.Value,
        Settings.SettingValue.IntegerValue integer => integer.Value,
        _ => null,
    };

    [JSInvokable]
    public void LoadSave(byte[] bytes, string fileName)
    {
        GameService.Load(bytes, fileName);
        Navigation.NavigateToHomePage();
    }

    [JSInvokable]
    public void Navigate(string url) => Navigation.NavigateTo(url);

    public record SaveFile(byte[] Bytes, string FileName, string Version);

    private static string ThemeName(GlobalTheme theme) => theme == GlobalTheme.Dark ? "dark" : "light";

    private async Task HandleThemeChanged(GlobalTheme theme)
    {
        if (_module is not null) await _module.InvokeVoidAsync("setTheme", _id, ThemeName(theme));
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        AntdThemeService.ThemeChanged -= HandleThemeChanged;

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("unmount", _id);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _self?.Dispose();
    }
}
