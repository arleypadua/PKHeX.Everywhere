@implements IAsyncDisposable
@inject IJSRuntime Js
@inject GameService GameService
@inject NavigationManager Navigation
@inject INotificationService Notification
@inject IConfiguration Configuration
@inject UserJourneyService UserJourney

<div @ref="_element" style="@Style"></div>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = default!;
    [Parameter] public Dictionary<string, object?>? Props { get; set; }
    [Parameter] public bool RequiresSave { get; set; } = true;
    [Parameter] public string Style { get; set; } = "width: 100%";

    private readonly string _id = Guid.NewGuid().ToString("N");
    private ElementReference _element;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ReactPage>? _self;
    private bool _disposed;

    protected override void OnInitialized()
    {
        GameService.OnGameLoaded += HandleGameLoaded;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (RequiresSave && !GameService.IsLoaded) return;

        _module ??= await Js.InvokeAsync<IJSObjectReference>("import", "./Components/ReactPage.razor.js");
        if (_disposed) return;
        _self ??= DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("mount", _id, _element, Configuration["React:DevServerUrl"], Name, Props ?? [], _self);
    }

    [JSInvokable]
    public void NavigateTo(string url, bool replace) => Navigation.NavigateTo(url, replace: replace);

    [JSInvokable]
    public void GoHome() => UserJourney.IgnoreFirstLoadAndGoToHome();

    [JSInvokable]
    public void NotifySuccess(string title) => _ = Notification.Open(new() { Message = title, NotificationType = NotificationType.Success });

    private void HandleGameLoaded(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        GameService.OnGameLoaded -= HandleGameLoaded;

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("unmount", _id);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _self?.Dispose();
    }
}
