@implements IAsyncDisposable
@inject IJSRuntime Js
@inject GameService GameService
@inject AntdThemeService ThemeService
@inject NavigationManager Navigation
@inject IConfiguration Configuration

<div @ref="_element" style="width: 100%"></div>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = default!;
    [Parameter] public Dictionary<string, object?>? Props { get; set; }

    private readonly string _id = Guid.NewGuid().ToString("N");
    private ElementReference _element;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ReactPage>? _self;
    private bool _disposed;

    protected override void OnInitialized()
    {
        AntdThemeService.ThemeChanged += HandleThemeChanged;
        GameService.OnGameLoaded += HandleGameLoaded;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!GameService.IsLoaded) return;

        _module ??= await Js.InvokeAsync<IJSObjectReference>("import", "./Components/ReactPage.razor.js");
        if (_disposed) return;
        _self ??= DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("mount", _id, _element, Configuration["React:DevServerUrl"], Name, Props ?? [], _self, ThemeName(ThemeService.Theme));
    }

    [JSInvokable]
    public void NavigateTo(string url) => Navigation.NavigateTo(url);

    private static string ThemeName(GlobalTheme theme) => theme == GlobalTheme.Dark ? "dark" : "light";

    private async Task HandleThemeChanged(GlobalTheme theme)
    {
        if (_module is not null) await _module.InvokeVoidAsync("setTheme", ThemeName(theme));
    }

    private void HandleGameLoaded(object? sender, EventArgs e) => InvokeAsync(async () =>
    {
        if (_module is not null) await _module.InvokeVoidAsync("unmount", _id);
        StateHasChanged();
    });

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        AntdThemeService.ThemeChanged -= HandleThemeChanged;
        GameService.OnGameLoaded -= HandleGameLoaded;

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("unmount", _id);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _self?.Dispose();
    }
}
