@inject ReactApp ReactApp

<div
    class="news_banner @(_isVisible ? "news_banner__visible" : "")">
    <Alert
        Type="AlertType.Info"
        Banner
        Closable
        CloseText="Dismiss"
        OnClose="DismissNews"
        ShowIcon="false">
        <span class="news_banner__content">
            <div>
                PKHeX.Web just got updated
                <br/>
                See <a href="release-notes?since=@_since">what's new</a>.
            </div>
        </span>
    </Alert>
</div>

@code {

    private bool _isVisible = false;
    private string? _since;
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var news = await ReactApp.InvokeAsync<UnseenNews>("checkUnseenNews");
        _since = news.Since;
        if (!news.Unseen) return;

        await Task.Delay(2000);
        _isVisible = true;
        StateHasChanged();

        _ = AutoDismiss();
    }

    private async Task AutoDismiss()
    {
        await Task.Delay(10000);
        _isVisible = false;

        // after 10 seconds we don't want to be bothered with it anymore
        await ReactApp.InvokeVoidAsync("markNewsSeen");
        
        StateHasChanged();
    }

    private Task DismissNews() => ReactApp.InvokeVoidAsync("markNewsSeen");

    private record UnseenNews(string? Since, bool Unseen);

}

<style>
    .news_banner {
        position: absolute;
        top: 0;
        width: 100%;
        z-index: 9;

        transition: opacity 0.5s ease-in-out;
        opacity: 0;
        pointer-events: none;
    }
    
    .news_banner__visible {
        opacity: 1;
        pointer-events: auto;
    }

    .news_banner .ant-alert-close-text {
        font-size: 0.7em !important;
    }

    .news_banner__content {
        font-size: 0.7em;
        display: flex;
        justify-content: center;
    }
</style>
