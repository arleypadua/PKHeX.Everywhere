@inject ReactApp ReactApp
@* Injected only so they attach to the Session for the app's lifetime. *@
@inject PKHeX.Everywhere.Engine.PlugIns.PlugInHost PlugInHost
@inject GameService GameService

@code
{
#if DEBUG
    private const bool AutoLoad = true;
#else
    private const bool AutoLoad = false;
#endif

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !OperatingSystem.IsBrowser()) return;

        PKHeX.Everywhere.Engine.EngineExports.SignalReady();
        await ReactApp.InvokeVoidAsync("start", new { autoLoad = AutoLoad });
    }
}
